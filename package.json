{
  "name": "optilog-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:turbo": "next dev --turbo",
    "dev:3001": "next dev --turbo -p 3001",
    "build": "next build",
    "build:safe": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-fallback.ps1",
    "start": "node scripts/start.js",
    "lint": "next lint",
    "format": "prettier --write .",
    "api": "node backend/server.js",
    "scaffold": "node scripts/scaffold.js",
    "scaffold:backend:express-basic": "node scripts/scaffold.js backend express-basic",
    "scaffold:backend:ors-route": "node scripts/scaffold.js backend ors-route-proxy",
    "scaffold:backend:ws-basic": "node scripts/scaffold.js backend ws-basic",
    "scaffold:frontend:module": "node scripts/scaffold.js frontend next-module",
    "scaffold:frontend:livemap": "node scripts/scaffold.js frontend livemap",
    "scaffold:init-basic": "npm run scaffold:backend:express-basic && npm run scaffold:backend:ors-route && npm run scaffold:backend:ws-basic && npm run scaffold:frontend:module && npm run scaffold:frontend:livemap",
    "db:seed": "node scripts/seed.mjs",
    "prepare": "echo \"Skipping husky on Vercel\"",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.34.0",
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@mui/material": "^5.15.20",
    "@neondatabase/serverless": "^0.9.5",
    "@types/leaflet": "^1.9.21",
    "bcryptjs": "^3.0.2",
    "jose": "^6.1.0",
    "jsonwebtoken": "^9.0.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "next": "^14.2.11",
    "openai": "^6.5.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-leaflet": "^5.0.0",
    "socket.io-client": "^4.8.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "24.7.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "autoprefixer": "^10.4.21",
    "eslint": "8.47.0",
    "eslint-config-next": "14.2.11",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-unused-imports": "^4.2.0",
    "husky": "^9.1.7",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.14",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.3.0",
    "vitest": "^1.5.0"
  },
  "browser": {
    "undici": false,
    "@undici/web": false,
    "@undici/*": false
  }
}
