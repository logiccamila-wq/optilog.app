{
  "name": "Optilog Dev",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "postCreateCommand": "bash .devcontainer/postcreate.sh",
  "updateContentCommand": "bash .devcontainer/postcreate.sh",
  "containerEnv": {
    "PLAYWRIGHT_BROWSERS_PATH": "/workspaces/.cache/ms-playwright"
  },
  "forwardPorts": [3000, 3011, 5173],
  "customizations": {
    "vscode": {
      "extensions": ["esbenp.prettier-vscode", "ms-vscode.js-debug", "ms-playwright.playwright"]
    }
  },
  "remoteEnv": {
    "SKIP_ENV_VALIDATION": "true",
    "SKIP_LINT": "true"
  },
  "features": {},
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  },
  "onCreateCommand": "echo 'Codespace created. See CODESPACES_MANAGEMENT.md for optimization tips.'",
  "waitFor": "postCreateCommand"
}
