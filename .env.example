# Neon PostgreSQL
DATABASE_URL=postgresql://<usuario>:<senha>@<host>/<database>?sslmode=require
NEON_DATA_API_URL=https://<sua_instancia_neon>.neon.tech

# JWT para RLS
NEON_AUTH_JWKS_URL=https://<issuer>/.well-known/jwks.json
NEON_AUTH_ISSUER=https://<issuer>
NEON_AUTH_AUDIENCE=<audience>

# Firebase (desativado)
NEXT_PUBLIC_DISABLE_FIREBASE=1

# Variáveis públicas da empresa
NEXT_PUBLIC_COMPANY_CNPJ=60.262.825/0001-06
NEXT_PUBLIC_COMPANY_NAME=XYZ LOGIC FLOW INOVA SIMPLES (I.S.)
NEXT_PUBLIC_COMPANY_ADDRESS=Rua Coimbra, 381, Residencial Doce Bela, Casa 5, Candeias, Jaboatão dos Guararapes/PE
NEXT_PUBLIC_COMPANY_EMAIL=contato@xyzlogicflow.tech
NEXT_PUBLIC_COMPANY_PHONE=+55 81 99999-9999
NEXT_PUBLIC_COMPANY_CLIENT=EJG Evolução em Transporte Ltda.
NEXT_PUBLIC_COMPANY_CLIENT_STATUS=Cliente Piloto
NEXT_PUBLIC_COMPANY_FOOTER_NOTE=Startup XYZLOGICFLOW – Cliente Piloto EJG

# OpenAI
OPENAI_API_KEY=

# Spring Integration Gateway (HTTP)
