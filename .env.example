JWT_SECRET=seu_jwt_secret_aqui                # Secret para JWT
DB_URL=sua_url_do_banco                       # URL de conexão com o banco de dados

# Neon PostgreSQL (produção)
DATABASE_URL=postgresql://<usuario>:<senha>@<host>/<database>?sslmode=require
NEON_DATA_API_URL=https://<sua_instancia_neon>.neon.tech

