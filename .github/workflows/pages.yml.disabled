name: Build and Deploy Pages

on:
  push:
    branches: [main]
  workflow_dispatch:

permissions:
  pages: write
  id-token: write
  contents: read

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '20'

      - name: Install and Build (frontend)
        run: |
          if [ -d frontend ]; then
            cd frontend
            if [ -f package-lock.json ]; then npm ci; else npm install; fi
            if npm run | grep -q "build"; then npm run build; else echo "No build script found" && exit 1; fi
          else
            echo "frontend directory not found" && exit 1
          fi

      - name: Resolve publish directory
        run: |
          if [ -d frontend/dist ]; then echo "PUBLISH_DIR=frontend/dist" >> $GITHUB_ENV;
          elif [ -d frontend/out ]; then echo "PUBLISH_DIR=frontend/out" >> $GITHUB_ENV;
          elif [ -d frontend/build ]; then echo "PUBLISH_DIR=frontend/build" >> $GITHUB_ENV;
          else echo "PUBLISH_DIR=frontend/dist" >> $GITHUB_ENV; fi
          echo "Using publish dir: $PUBLISH_DIR"

      - name: Upload Pages artifact
        uses: actions/upload-pages-artifact@v3
        with:
          path: ${{ env.PUBLISH_DIR }}

  deploy:
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    runs-on: ubuntu-latest
    needs: build
    steps:
      - name: Deploy to GitHub Pages
        id: deployment
        uses: actions/deploy-pages@v4
