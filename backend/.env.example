# Exemplo de variáveis de ambiente para o backend Express

# Porta do servidor
PORT=3011

# Banco de dados SQLite local
# Caminho relativo será resolvido a partir do diretório deste arquivo (backend/)
# Recomenda-se manter o arquivo no backend e não versioná-lo
DB_PATH=./optilog.db

# JWT para autenticação
JWT_SECRET=sua_chave_segura_aqui

# Outras variáveis opcionais
OPENAI_API_KEY=
DATABASE_URL=