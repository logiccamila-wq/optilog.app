# Optilog App – exemplo local (.env.local)

# Banco de dados (Neon / Postgres)
# Use endpoint direto para DDL/migrações; use o pooled em runtime quando necessário.
DATABASE_URL=postgresql://USER:PASSWORD@ep-your-branch-pooler.REGION.aws.neon.tech/DB?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-your-branch.REGION.aws.neon.tech/DB?sslmode=require

# Backend Express local
# Porta e URL do backend local (usa PORT do backend/.env)
NEXT_PUBLIC_BACKEND_URL=http://localhost:3011

# ML service local
NEXT_PUBLIC_ML_URL=http://localhost:8000

# API interna do Next (opcional; quando consumir via client)
NEXT_PUBLIC_POSTS_API_URL=http://localhost:3000/api

# Firebase (Frontend)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Feature flags / defaults
NEXT_PUBLIC_DISABLE_FIREBASE=1
NEXT_PUBLIC_DEFAULT_LOCALE=pt
NEXT_PUBLIC_DELETE_GRACE_MS=5000

# Integrações locais
NEXT_PUBLIC_IOT_WS_URL=ws://localhost:4010
NEXT_PUBLIC_ORS_PROXY_URL=http://localhost:4001/route

# OpenAI (servidor)
OPENAI_API_KEY=

# UI/empresa (opcional)
NEXT_PUBLIC_DASHBOARD_URL=
NEXT_PUBLIC_COMPANY_CNPJ=49.174.848/0001-09
NEXT_PUBLIC_COMPANY_NAME=XYZ LOGIC FLOW INOVA SIMPLES (I.S.)
NEXT_PUBLIC_COMPANY_ADDRESS=Rua Padre Hamilton Tadeu Maito, 125, Cidade Vitoria, Assis/SP, 19807-075
NEXT_PUBLIC_COMPANY_EMAIL=xyzlogicflow@gmail.com
NEXT_PUBLIC_COMPANY_PHONE=+55 18 99636-1278
NEXT_PUBLIC_FOOTER_LABEL_STARTUP=xyzlogicflow startup
NEXT_PUBLIC_FOOTER_LABEL_PILOT_CLIENT=ejg cliente piloto

# Stack Auth (GitHub OAuth, opcional)
NEXT_PUBLIC_STACK_AUTH_PROJECT_ID=
STACK_AUTH_JWKS_URL=https://api.stack-auth.com/v1/jwks
NEXT_PUBLIC_STACK_AUTH_AUTHORIZE_URL=
NEXT_PUBLIC_STACK_AUTH_REDIRECT_URL=http://localhost:3000/api/auth/callback


# Neon Data API (REST Beta) — local
NEON_DATA_API_URL=https://ep-small-shape-aclozfov.apirest.sa-east-1.aws.neon.tech/neondb/rest/v1

# Neon Auth (JWT) — local (ajuste conforme seu projeto)
NEON_AUTH_JWKS_URL=https://api.stack-auth.com/api/v1/projects/<project-id>/.well-known/jwks.json
NEON_AUTH_ISSUER=https://api.stack-auth.com/api/v1/projects/<project-id>
NEON_AUTH_AUDIENCE=<your-audience>